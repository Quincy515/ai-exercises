default:
    @just --list

# build with one BoltFFI version, derived from the workspace Cargo dependency
[script('bash')]
[working-directory('shared')]
wasm:
    set -euo pipefail
    boltffi_version="$(cargo metadata --no-deps --format-version 1 --locked | node -e 'const fs = require("node:fs"); const metadata = JSON.parse(fs.readFileSync(0, "utf8")); const req = metadata.packages.find(p => p.name === "shared").dependencies.find(d => d.name === "boltffi").req; if (!/^=\d+\.\d+\.\d+$/.test(req)) throw new Error("Pin boltffi to an exact stable version in Cargo.toml"); process.stdout.write(req.slice(1));')"
    if [[ "$(boltffi --version 2>/dev/null || true)" != "boltffi $boltffi_version" ]]; then
        cargo install boltffi_cli --version "=$boltffi_version" --locked --force
    fi
    if [[ "$(boltffi --version)" != "boltffi $boltffi_version" ]]; then
        echo "PATH still selects a different BoltFFI; use the cargo-installed boltffi $boltffi_version." >&2
        exit 1
    fi
    # The generator typechecks against this runtime before pnpm installs shared.
    if ! node -e 'const fs = require("node:fs"); for (const [name, version] of [["@boltffi/runtime", process.argv[1]], ["typescript", "5.9.3"], ["@types/node", "22.20.2"]]) { const p = JSON.parse(fs.readFileSync(`../generated/node_modules/${name}/package.json`, "utf8")); if (p.version !== version) process.exit(1); }' "$boltffi_version" 2>/dev/null; then
        npm install --prefix ../generated --no-save --package-lock=false --ignore-scripts --no-audit --no-fund "@boltffi/runtime@$boltffi_version" typescript@5.9.3 @types/node@22.20.2
    fi
    export PATH="$PWD/../generated/node_modules/.bin:$PATH"
    runtime_config="$(mktemp)"
    trap 'rm -f "$runtime_config"' EXIT
    printf '[targets.wasm.typescript]\nruntime_version = "%s"\n' "$boltffi_version" > "$runtime_config"
    boltffi --overlay "$runtime_config" pack wasm -v

# generate types for TypeScript in the workspace's generated directory
typegen:
    RUST_LOG=info cargo run --locked \
        --package shared --bin codegen \
        --features codegen,facet_typegen \
        -- --language typescript --output-dir generated/types

# generate shared packages before pnpm installs their file: dependencies
build-shared: wasm typegen

# refresh the generated local packages
install: build-shared
    pnpm install --frozen-lockfile
    # pnpm may cache dependencies of file: packages after their manifest changes.
    @node -e 'const fs = require("node:fs"); const expected = JSON.parse(fs.readFileSync("generated/pkg/package.json", "utf8")).dependencies["@boltffi/runtime"]; const installed = JSON.parse(fs.readFileSync("node_modules/@boltffi/runtime/package.json", "utf8")).version; if (installed !== expected) process.exit(1);' 2>/dev/null || pnpm --filter @apps/frontend update shared
    # 本地生成包版本不变时 Vite 会复用旧类型；更新 shared 后清除两端预构建缓存。
    rm -rf ./tanstack-app/node_modules/.vite ./electron-app/node_modules/.vite

# serve the web shell
dev-web: install
    pnpm --filter tanstack-app dev

# serve the desktop shell
dev-desktop: install
    pnpm --filter electron-app start

# build the web shell
build-web: install
    pnpm --filter tanstack-app build

# package the desktop shell
build-desktop: install
    pnpm --filter electron-app package

# shared dependencies run once per just invocation
build: build-web build-desktop

# run the Rust core tests
test:
    cargo test --locked -p shared --lib
