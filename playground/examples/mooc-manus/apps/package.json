{
  "name": "apps",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev:web": "pnpm --filter tanstack-app dev",
    "dev:desktop": "pnpm --filter electron-app start",
    "typecheck": "pnpm -r typecheck",
    "build:web": "pnpm --filter tanstack-app build",
    "build:desktop": "pnpm --filter electron-app package",
    "build": "pnpm build:web && pnpm build:desktop"
  }
}
