# 复制为 .env。密码使用 openssl rand -hex 32 生成，避免数据库 URL 特殊字符。
POSTGRES_PASSWORD=
JWT_SECRET=

# 浏览器访问的完整站点地址，不带 /api。域名部署时改成 https://你的域名。
PUBLIC_BASE_URL=http://localhost:8080

# 默认只供宿主机 HTTPS 反向代理或 SSH 隧道访问。
WEB_BIND=127.0.0.1
WEB_PORT=8080

# 两项与动态沙箱的 Docker 配置共用。
SANDBOX_IMAGE=manus-sandbox:local
SANDBOX_NETWORK=manus-network
